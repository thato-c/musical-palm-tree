@using OnlineCampus.ViewModels
@model AdminDetailViewModel

<h1>Delete Admin</h1>

<form asp-controller="Admin" asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="AdminId" />
    <input type="hidden" asp-for="RowVersion" />

    <div class="form-group">
        <label asp-for="FirstName">FirstName</label>
        <input asp-for="FirstName" class="form-control" readonly/>
    </div>

    <div class="form-group">
        <label asp-for="LastName">LastName</label>
        <input asp-for="LastName" class="form-control" readonly />
    </div>

    <button type="submit">Delete</button>
</form>