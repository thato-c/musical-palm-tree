@using OnlineCampus.ViewModels
@model AdminDetailViewModel

<h1>Edit Admin</h1>

<form asp-conreoller="Admin" asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger">
        <input type="hidden" asp-for="AdminId" />
        <input type="hidden" asp-for="RowVersion" />
    </div>

    <div class="form-group">
        <label asp-for="FirstName">FirstName</label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName">LastName</label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <button type="submit">Edit</button>

</form>