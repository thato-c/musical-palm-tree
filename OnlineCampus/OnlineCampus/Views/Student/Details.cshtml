@using OnlineCampus.ViewModels
@model StudentDetailsViewModel

<h1>Student Details</h1>

<form asp-controller="Student" asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger">
        <input type="hidden" asp-for="StudentId" />
        <input type="hidden" asp-for="RowVersion" />
    </div>

    <div class="form-group">
        <label asp-for="FirstName">FirstName</label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName">LastName</label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
</form>

<hr />

<h2>Enrolled Courses</h2>
@if (Model.EnrolledCourses != null && Model.EnrolledCourses.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Code</th>
                <th>Credits</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model.EnrolledCourses)
            {
                <tr>
                    <td>@course.Name</td>
                    <td>@course.Code</td>
                    <td>@course.Credits</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>The student has not enrolled in any course.</p>
}